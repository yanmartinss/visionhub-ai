// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  manager
  employee
  admin
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  active             Boolean  @default(true)
  passwordHash       String
  role               Role     @default(employee)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

enum StatusRequest {
  pending
  approved
  rejected
}

model Request {
  id          String        @id @default(uuid())
  name        String
  email       String
  condominium String
  message     String?
  status      StatusRequest @default(pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model Camera {
  id        String   @id @default(uuid())
  name      String
  location  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  areas  Area[]
  rules  Rule[]
  events Event[]
}

enum AreaType {
  restricted
  sensitive
}

model Area {
  id        String   @id @default(uuid())
  type      AreaType
  cameraId  String
  polygon   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id])
}

enum EventType {
  gateOpen
  occupancy
  restrictedArea
  abandonedObject
  other
}

model Rule {
  id               String    @id @default(uuid())
  cameraId         String
  eventType        EventType
  timeLimitSeconds Int?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id])
}

model Event {
  id                   String    @id @default(uuid())
  cameraId             String
  type                 EventType
  technicalDescription String?
  startedAt            DateTime
  endedAt              DateTime?
  createdAt            DateTime  @default(now())

  camera Camera  @relation(fields: [cameraId], references: [id])
  alerts Alert[]

  @@index([cameraId, startedAt])
}

model Alert {
  id        String    @id @default(uuid())
  eventId   String
  sentAt    DateTime
  viewedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  event Event @relation(fields: [eventId], references: [id])
}

model DailySummary {
  id            String   @id @default(uuid())
  referenceDate DateTime @db.Date
  generatedText String
  createdAt     DateTime @default(now())
}
