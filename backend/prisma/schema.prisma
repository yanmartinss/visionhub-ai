// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  manager
  employee
  admin
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  active              Boolean   @default(true)
  passwordHash        String
  role                Role      @default(employee)
  isMaster            Boolean   @default(false)
  mustChangePassword  Boolean   @default(false)
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  recordingDays RecordingDay[]
}

enum StatusRequest {
  pending
  approved
  rejected
}

model Request {
  id          String        @id @default(uuid())
  name        String
  email       String
  condominium String
  message     String?
  status      StatusRequest @default(pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model Camera {
  id        String   @id @default(uuid())
  name      String
  location  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  areas         Area[]
  rules         Rule[]
  events        Event[]
  recordingDays RecordingDay[]
}

enum AreaType {
  restricted
  sensitive
}

model Area {
  id        String   @id @default(uuid())
  type      AreaType
  cameraId  String
  polygon   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id])
}

enum EventType {
  gateOpen
  occupancy
  restrictedArea
  abandonedObject
  other
}

model Rule {
  id               String    @id @default(uuid())
  cameraId         String
  eventType        EventType
  timeLimitSeconds Int?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id])
}

model Event {
  id                   String    @id @default(uuid())
  cameraId             String
  type                 EventType
  technicalDescription String?
  startedAt            DateTime
  endedAt              DateTime?
  segmentId            String?
  occurredAt           DateTime?
  confidence           Float?
  thumbnailPath        String?
  clipPath             String?
  createdAt            DateTime  @default(now())

  camera  Camera   @relation(fields: [cameraId], references: [id])
  segment Segment? @relation(fields: [segmentId], references: [id])
  alerts  Alert[]

  @@index([cameraId, startedAt])
  @@index([segmentId])
}

model Alert {
  id        String    @id @default(uuid())
  eventId   String
  sentAt    DateTime
  viewedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  event Event @relation(fields: [eventId], references: [id])
}

model DailySummary {
  id             String   @id @default(uuid())
  referenceDate  DateTime @db.Date
  generatedText  String
  recordingDayId String?  @unique
  createdAt      DateTime @default(now())

  recordingDay RecordingDay? @relation(fields: [recordingDayId], references: [id])
}

enum RecordingDayStatus {
  pending
  processing
  completed
  partial
  failed
}

enum SegmentStatus {
  received
  processing
  completed
  failed
}

enum SegmentSourceType {
  upload
  link
}

model RecordingDay {
  id        String             @id @default(uuid())
  cameraId  String
  date      DateTime           @db.Date
  status    RecordingDayStatus @default(pending)
  createdBy String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt

  camera       Camera        @relation(fields: [cameraId], references: [id])
  creator      User          @relation(fields: [createdBy], references: [id])
  segments     Segment[]
  dailySummary DailySummary?

  @@unique([cameraId, date])
}

model Segment {
  id             String            @id @default(uuid())
  recordingDayId String
  sourceType     SegmentSourceType
  sourceRef      String
  storagePath    String?
  fileHash       String?
  startedAt      DateTime
  durationSec    Int?
  status         SegmentStatus     @default(received)
  attempts       Int               @default(0)
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  recordingDay RecordingDay @relation(fields: [recordingDayId], references: [id])
  events       Event[]

  @@unique([recordingDayId, fileHash])
  @@index([recordingDayId, startedAt])
}

model Condominium {
  id           String   @id @default(uuid())
  name         String
  cep          String?
  street       String?
  neighborhood String?
  number       String?
  city         String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}
